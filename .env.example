# ---------------------------------------------------------------------------
# Client configuration
# ---------------------------------------------------------------------------
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time
# and is readable by anyone who unpacks the binary. Treat this file as a list of
# values you are happy to publish.
#
# Both values below are safe to ship: the anon key only grants what Row Level
# Security allows, and every table denies access without a matching auth.uid().
#
# Copy to `.env.local` and fill in from your Supabase project settings
# (Project Settings -> API).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# development | preview | production — used to label non-production builds.
EXPO_PUBLIC_APP_ENV=development


# ---------------------------------------------------------------------------
# Android APK builds (EAS) — local-only, not inlined into the app bundle
# ---------------------------------------------------------------------------
# Needed only to run `scripts/build-android-apk.sh` (or `eas build`) yourself.
# Neither variable is prefixed EXPO_PUBLIC_, so neither is compiled into the
# app; APP_VERSION is read once at config-eval time to stamp the build, and
# EAS_PROJECT_ID just tells the EAS CLI which project to talk to (it is not
# secret — see docs/android-builds.md).
#
#   EXPO_TOKEN       lives in your shell env only, never in a file — an EAS
#                     access token, generated at expo.dev. Do not add it here.
#   EAS_PROJECT_ID    from `eas init`, run once (see docs/android-builds.md).
#   APP_VERSION       optional; the release workflow sets this from the git
#                     tag automatically. Leave unset for local builds.

EAS_PROJECT_ID=


# ---------------------------------------------------------------------------
# Server-side secrets — DO NOT PUT THESE HERE
# ---------------------------------------------------------------------------
# The following must never appear in this file, in app.config.cjs, or anywhere
# else in the client bundle. They are configured as Supabase Edge Function
# secrets (`supabase secrets set NAME=value`) and are only readable server-side:
#
#   SUPABASE_SERVICE_ROLE_KEY   bypasses Row Level Security entirely
#   ANTHROPIC_API_KEY           billed model access
#
# If either of these ends up in the client, rotate it immediately.
